# ============================================================================
# Project F — Backend Environment Configuration (.env.example)
# - Copy file này thành `.env` (cấu hình gốc) hoặc `.env.local` (ghi đè cá nhân).
# - Các biến trong `.env.local` sẽ tự động ghi đè biến trùng tên trong `.env`.
# ============================================================================

# Server & Profile Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Amazon RDS / Supabase / Local)
DB_URL=jdbc:postgresql://localhost:5432/project_f_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JPA Configuration
JPA_DDL_AUTO=validate

# AWS S3 Configuration
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=project-f-media-storage-fcode
AWS_S3_PRESIGNED_EXPIRATION_MINUTES=10

# AWS Credentials (Tùy chọn: IAM User hoặc AWS Academy Learner Lab)
# Nếu không cung cấp, SDK sẽ tự tìm qua DefaultCredentialsProvider (~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
