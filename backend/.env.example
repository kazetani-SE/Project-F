# ============================================================================
# Project F — Backend Environment Configuration (.env.example)
# - Copy file này thành `.env` (cấu hình gốc) hoặc `.env.local` (ghi đè cá nhân).
# - Các biến trong `.env.local` sẽ tự động ghi đè biến trùng tên trong `.env`.
# ============================================================================

# Server & Profile Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Amazon RDS / Supabase / Local)
DB_URL=jdbc:postgresql://localhost:5432/project_f_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JPA Configuration
JPA_DDL_AUTO=validate

# AWS S3 Configuration
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=project-f-media-storage-fcode
AWS_S3_PRESIGNED_EXPIRATION_MINUTES=10

# AWS Credentials (Tùy chọn: IAM User hoặc AWS Academy Learner Lab)
# Nếu không cung cấp, SDK sẽ tự tìm qua DefaultCredentialsProvider (~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AI / LLM Configuration (bedrock hoặc gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FAST_MODEL_ID=gemini-3.5-flash-lite
GEMINI_DEEP_MODEL_ID=gemini-3.5-flash
AWS_BEDROCK_REGION=us-east-1
BEDROCK_FAST_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_DEEP_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Benchmark AI Mode (cache cho mock hoặc live cho gọi AI thật)
BENCHMARK_AI_MODE=cache
BENCHMARK_AI_CACHE_FILE=classpath:cache/benchmark-ai-cache.json

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AWS Cognito Auth Configuration
AWS_COGNITO_REGION=ap-southeast-1
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_CLIENT_SECRET=

# Amazon SES v2 SDK Configuration (Gửi mail trực tiếp qua AWS SDK & IAM Role)
AWS_SES_REGION=ap-southeast-1
AWS_SES_ENABLED=true
AWS_SES_CONFIGURATION_SET=
APP_MAIL_FROM=Project F <event.fcode.sys@gmail.com>
APP_LOGIN_URL=http://localhost:5173/login

# SMTP Fallback (chỉ dùng khi đặt AWS_SES_ENABLED=false ở local với Mailpit)
SPRING_MAIL_HOST=127.0.0.1
SPRING_MAIL_PORT=54325
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
