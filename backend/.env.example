# ============================================================================
# Project F — Backend Environment Configuration (.env.example)
# - Copy file này thành `.env` trong thư mục backend và điền giá trị cho máy của bạn.
# - Spring Boot chỉ tự nạp `.env`; biến trong IntelliJ Run Configuration có thể ghi đè.
# ============================================================================

# Server & Profile Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Amazon RDS / Supabase / Local)
DB_URL=jdbc:postgresql://localhost:5432/project_f_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JPA Configuration
JPA_DDL_AUTO=validate

# AWS S3 Configuration
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=project-f-media-storage
AWS_S3_PRESIGNED_EXPIRATION_MINUTES=10

# Supabase Auth verification (public publishable key, never service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CORS_ALLOWED_ORIGINS=http://localhost:5173
