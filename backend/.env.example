# ============================================================================
# Project F — Backend Environment Configuration (.env.example)
# - Copy file này thành `.env` (cấu hình gốc) hoặc `.env.local` (ghi đè cá nhân).
# - Các biến trong `.env.local` sẽ tự động ghi đè biến trùng tên trong `.env`.
# ============================================================================

# Server & Profile Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Amazon RDS / Supabase / Local)
DB_URL=jdbc:postgresql://localhost:5432/project_f_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JPA Configuration
JPA_DDL_AUTO=validate

# AWS S3 Configuration
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=project-f-media-storage-fcode
AWS_S3_PRESIGNED_EXPIRATION_MINUTES=10

# AWS Credentials (Tùy chọn: IAM User hoặc AWS Academy Learner Lab)
# Nếu không cung cấp, SDK sẽ tự tìm qua DefaultCredentialsProvider (~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Supabase Auth (use an asymmetric project signing key)
SUPABASE_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URI=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Chỉ backend dùng key quản trị; không đưa key này vào frontend hoặc Git.
SUPABASE_SERVICE_ROLE_KEY=
# SMTP local có thể dùng Mailpit qua cổng 54325 sau khi bật local_smtp.smtp_port.
SPRING_MAIL_HOST=127.0.0.1
SPRING_MAIL_PORT=54325
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
APP_MAIL_FROM=Project F <no-reply@projectf.local>
APP_LOGIN_URL=http://localhost:5173/login
