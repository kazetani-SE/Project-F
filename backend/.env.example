# ============================================================================
# Project F — Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in your environment-specific values.
# ============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (Amazon RDS / Supabase / Local)
DB_URL=jdbc:postgresql://localhost:5432/project_f_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Flyway & JPA Configuration
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate

# AWS S3 Configuration
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=project-f-media-storage
AWS_S3_PRESIGNED_EXPIRATION_MINUTES=10
