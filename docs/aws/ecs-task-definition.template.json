{
  "family": "project-f-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/project-f-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.ap-southeast-1.amazonaws.com/project-f-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "8080" },
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "JPA_DDL_AUTO", "value": "validate" },
        { "name": "DB_URL", "value": "jdbc:postgresql://projectf-database-1.c10ww06se2dj.ap-southeast-1.rds.amazonaws.com:5432/projectf?sslmode=require" },
        { "name": "DB_USERNAME", "value": "postgres" },
        { "name": "AWS_REGION", "value": "ap-southeast-1" },
        { "name": "AI_PROVIDER", "value": "bedrock" },
        { "name": "AWS_BEDROCK_REGION", "value": "ap-southeast-2" },
        { "name": "BEDROCK_FAST_MODEL_ID", "value": "apac.anthropic.claude-3-haiku-20240307-v1:0" },
        { "name": "BEDROCK_DEEP_MODEL_ID", "value": "apac.anthropic.claude-3-5-sonnet-20241022-v2:0" },
        { "name": "AWS_COGNITO_REGION", "value": "ap-southeast-1" },
        { "name": "AWS_COGNITO_USER_POOL_ID", "value": "<COGNITO_USER_POOL_ID>" },
        { "name": "AWS_COGNITO_CLIENT_ID", "value": "<COGNITO_APP_CLIENT_ID>" },
        { "name": "AWS_SES_REGION", "value": "ap-southeast-1" },
        { "name": "AWS_SES_ENABLED", "value": "true" },
        { "name": "AWS_S3_BUCKET", "value": "project-f-fcode" },
        { "name": "AWS_S3_PRESIGNED_EXPIRATION_MINUTES", "value": "10" },
        { "name": "CORS_ALLOWED_ORIGINS", "value": "https://d1tfb39o1ucbfq.cloudfront.net" },
        { "name": "SPRING_MAIL_HOST", "value": "email-smtp.ap-southeast-1.amazonaws.com" },
        { "name": "SPRING_MAIL_PORT", "value": "587" },
        { "name": "SPRING_MAIL_SMTP_AUTH", "value": "true" },
        { "name": "SPRING_MAIL_SMTP_STARTTLS_ENABLE", "value": "true" },
        { "name": "APP_MAIL_FROM", "value": "Project F - F-Code <no-reply@sealfpthackathon.io.vn>" },
        { "name": "APP_LOGIN_URL", "value": "https://d1tfb39o1ucbfq.cloudfront.net/login" },
        { "name": "BENCHMARK_AI_MODE", "value": "cache" }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:<AWS_ACCOUNT_ID>:parameter/project-f/prod/DB_PASSWORD"
        },
        {
          "name": "SPRING_MAIL_USERNAME",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:<AWS_ACCOUNT_ID>:parameter/project-f/prod/SPRING_MAIL_USERNAME"
        },
        {
          "name": "SPRING_MAIL_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:<AWS_ACCOUNT_ID>:parameter/project-f/prod/SPRING_MAIL_PASSWORD"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-southeast-1:<AWS_ACCOUNT_ID>:parameter/project-f/prod/GEMINI_API_KEY"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fsS http://localhost:8080/api/v3/api-docs > /dev/null || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/project-f-backend",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
