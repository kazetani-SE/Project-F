# API qua Vite proxy khi chạy local. Sử dụng URL đầy đủ khi triển khai riêng.
VITE_API_BASE_URL=/api/v1
# URL dự án và public publishable key, hoặc VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng trong chế độ dev của Vite.
VITE_USE_MOCK=false
# Bật passthrough cho Storage để dùng Backend Spring Boot + Real S3 (khi false)
VITE_MOCK_STORAGE=false
