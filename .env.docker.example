# ============================================================================
# Project F — Docker Compose Environment Template (.env.docker.example)
# Copy file này thành `.env` ở thư mục gốc dự án trước khi chạy:
#   cp .env.docker.example .env
#   docker compose up -d --build
# ============================================================================

# --- Host Ports ---
FRONTEND_PORT=80
BACKEND_PORT=8080

# --- Backend Runtime ---
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=validate

# --- Database (Supabase Cloud / Amazon RDS / Local Postgres) ---
# Dùng Supabase Cloud hoặc RDS: điền JDBC URL tương ứng.
# Dùng profile local-db (`docker compose --profile local-db up -d`):
#   DB_URL=jdbc:postgresql://postgres:5432/project_f_db
DB_URL=jdbc:postgresql://postgres:5432/project_f_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Optional local-db container settings (khi dùng --profile local-db) ---
POSTGRES_PORT=5432
POSTGRES_DB=project_f_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- AWS S3 Configuration ---
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=project-f-media-storage-fcode
AWS_S3_PRESIGNED_EXPIRATION_MINUTES=10
# Để trống nếu deploy trên EC2 có gắn IAM Instance Profile
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# --- Supabase Auth (Backend JWT verification) ---
# Nếu dùng Supabase local trên máy host, thay 127.0.0.1 bằng host.docker.internal
SUPABASE_AUTH_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend Build Args (nhúng vào bundle Vite lúc build) ---
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_USE_MOCK=false
VITE_MOCK_STORAGE=false

# --- Mail / SMTP ---
SPRING_MAIL_HOST=host.docker.internal
SPRING_MAIL_PORT=54325
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
APP_MAIL_FROM=Project F <no-reply@projectf.local>
APP_LOGIN_URL=http://localhost/login

# --- AI Benchmark ---
BENCHMARK_AI_MODE=cache
GEMINI_API_KEY=
